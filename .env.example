# Copie para .env: cp .env.example .env
# Usado pelo docker compose e, por padrão, pela API (application.yaml).
POSTGRES_DB=roombook
POSTGRES_USER=roombook
POSTGRES_PASSWORD=troque-esta-senha
# Mude se a 5432 estiver ocupada; a API acompanha.
DB_PORT=5432

# Opcional: sobrescreve a conexão da API (ex.: banco externo)
# SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/roombook
# SPRING_DATASOURCE_USERNAME=roombook
# SPRING_DATASOURCE_PASSWORD=...
SERVER_PORT=8080
