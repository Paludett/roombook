# ===== maestri-kit · config do projeto (.claude/workflow.config) =====
# Gerado pela skill kit-init. Sem segredo, só portas e comandos de dev.

PROJECT_SLUG="roombook"
BASE_BRANCH="develop"
BRANCH_PREFIX="feature/issue-"
MAX_PARALLEL=3

# ---- Serviços (porta = base + número da issue) ----
SERVICES="API"

API_DIR="."
API_PORT_BASE=8400
API_RUN='./mvnw spring-boot:run'
API_TEST='./mvnw -q test'
API_TIMEOUT=240

# ---- Containers isolados por issue ----
CONTAINERS="DB"
DB_IMAGE="postgres:16"
DB_INNER_PORT=5432
DB_PORT_BASE=5700
DB_ENV="POSTGRES_DB=roombook POSTGRES_USER=roombook POSTGRES_PASSWORD=roombook"

# ---- Variáveis do floor (.wt.env) ----
ENV_TEMPLATE='
SERVER_PORT=$API_PORT
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:$DB_PORT/roombook
SPRING_DATASOURCE_USERNAME=roombook
SPRING_DATASOURCE_PASSWORD=roombook
'
